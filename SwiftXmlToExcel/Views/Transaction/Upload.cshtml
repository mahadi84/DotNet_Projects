
@{
    ViewData["Title"] = "Upload XML File";
}

<h1>Upload XML File</h1>

<form asp-controller="Transaction" asp-action="Upload" method="post" enctype="multipart/form-data">
    <input type="file" name="file" />
    <button type="submit">Upload</button>
</form>

<a href="@Url.Action("DownloadExcel", "Transaction")">Download Excel</a>
