@model CBS.Application.DTO.UserSearchDTO

<div class="container mt-4">
    <div class="card border-primary mb-4 shadow-sm">
        <div class="card-body bg-light">
            <form method="get" asp-action="ShowUserInfo" class="row g-3">
                <div class="col-md-9">
                    <input type="text" name="username" class="form-control form-control-lg"
                           placeholder="Search Username (e.g. admin, user01)" value="@Context.Request.Query["username"]" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Search User</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null)
    {
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">User Profile: @Model.Username</h5>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                    @(Model.IsActive ? "ACTIVE" : "INACTIVE")
                </span>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="text-muted small d-block">Full Username</label>
                        <p class="fs-5 fw-bold border-bottom pb-1">@Model.Username</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small d-block">Assigned Role</label>
                        <p class="fs-5 fw-bold border-bottom pb-1 text-primary">@Model.Role</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small d-block">Branch</label>
                        <p class="fs-5 fw-bold border-bottom pb-1">@Model.BranchName (@Model.BranchCode)</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="text-muted small d-block">Security Status</label>
                        <p class="fs-5 fw-bold border-bottom pb-1">
                            @if (Model.IsLocked)
                            {
                                <span class="text-danger"><i class="bi bi-lock-fill"></i> Locked</span>
                            }
                            else
                            {
                                <span class="text-success"><i class="bi bi-unlock-fill"></i> Unlocked</span>
                            }
                        </p>
                    </div>
                </div>

                <div class="mt-4">
                    <h6 class="text-uppercase text-muted border-bottom pb-2 mb-3">System Information</h6>
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <small class="d-block text-muted">Created Date</small>
                                <strong>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</strong>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <small class="d-block text-muted">Created By (ID)</small>
                                <strong>#@Model.CreatedBy</strong>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 bg-light rounded shadow-sm">
                                <small class="d-block text-muted">Last Login</small>
                                <strong>@(Model.LastLogin?.ToString("MMM dd, HH:mm") ?? "Never")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <a asp-action="Index" class="btn btn-secondary px-4">Back to List</a>
                    @* যদি পরে এডিট অপশন দিতে চান তবেই নিচের বাটনটি রাখবেন *@
                    <a asp-action="Manage" asp-route-username="@Model.Username" class="btn btn-warning px-4">Go to Edit Mode</a>
                </div>
            </div>
        </div>
    }
</div>