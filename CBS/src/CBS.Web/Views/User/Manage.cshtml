@model CBS.Application.DTO.UserUpdateDTO

<div class="container mt-4">
    <div class="card border-primary mb-4 shadow-sm">
        <div class="card-body bg-light">
            <form method="get" asp-action="Manage" class="row g-3">
                <div class="col-md-9">
                    <input type="text" name="username" class="form-control form-control-lg"
                           placeholder="Enter Username to Search (e.g. admin, user01)" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Search User</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null || TempData["Error"] != null || ViewBag.Error != null)
    {
        var isSuccess = TempData["Success"] != null;
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @(TempData["Success"] ?? TempData["Error"] ?? ViewBag.Error)
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null)
    {
        <div class="card shadow">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0">Edit User: @Model.Username</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Update" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="CreatedBy" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Username" class="form-label fw-bold">Username</label>
                            <input asp-for="Username" class="form-control bg-light" readonly />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-bold">User Role</label>
                            <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<CBS.Domain.Entities.UserRole>()">
                                <option value="">-- Select Role --</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        @* <div class="col-md-6">
                            <label asp-for="BranchCode" class="form-label fw-bold">Branch Code</label>
                            <input asp-for="BranchCode" class="form-control" />
                            <span asp-validation-for="BranchCode" class="text-danger small"></span>
                        </div> *@

                        <div class="col-md-6">
                            @* <label asp-for="BranchId" class="form-label fw-bold">Assigned Branch</label>
                            <select asp-for="BranchId" class="form-select" asp-items="ViewBag.BranchList">
                                <option value="">-- Select Branch Code --</option>
                            </select>
                            <span asp-validation-for="BranchId" class="text-danger small"></span> *@

                            <label asp-for="BranchId" class="form-label">Branch</label>
                            <select asp-for="BranchId" class="form-select"
                                    asp-items="@(ViewBag.Branches as SelectList)">
                                <option value="">-- Select Branch --</option>
                            </select>

                            @if (ViewBag.Branches == null)
                            {
                                <p class="text-muted small">No branches available</p>
                            }

                            <span asp-validation-for="BranchId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label fw-bold">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Leave blank to keep same" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold d-block">Account Status</label>
                            <div class="border rounded p-2 d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="true" id="stActive">
                                    <label class="form-check-label text-success" for="stActive">Active</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="IsActive" value="false" id="stInactive">
                                    <label class="form-check-label text-danger" for="stInactive">Inactive</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold d-block">Security</label>
                            <div class="form-check form-switch border rounded p-2 ps-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsLocked">
                                <label class="form-check-label" asp-for="IsLocked">Lock Account</label>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4 bg-light border rounded p-3 mx-0">
                        <div class="col-sm-4 text-center border-end">
                            <small class="text-muted d-block">Created At</small>
                            <span class="fw-bold">@Model.CreatedAt.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="col-sm-4 text-center border-end">
                            <small class="text-muted d-block">Created By</small>
                            <span class="fw-bold">#@Model.CreatedBy</span>
                        </div>
                        <div class="col-sm-4 text-center">
                            <small class="text-muted d-block">Last Update</small>
                            <span class="fw-bold">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</span>
                        </div>
                    </div>

                    <div class="mt-4 border-top pt-3 text-end">
                        <a asp-action="Manage" class="btn btn-outline-secondary px-4 me-2">Cancel</a>
                        <button type="submit" class="btn btn-success px-5 shadow-sm">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}