@using CBS.Domain.Common
@using CBS.Application.DTO
@using System.Text.Encodings.Web
@model PagedResult<IEnumerable<AuditReportViewDTO>>

@{
    ViewData["Title"] = "Audit Trail Report";
}

<div class="container-fluid mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-invoice"></i> Audit Trail Report</h1>
        <a href="@Url.Action("Index")" class="d-none d-sm-inline-block btn btn-sm btn-outline-secondary shadow-sm">
            <i class="fas fa-sync-alt fa-sm"></i> Refresh Report
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-light">
            <h6 class="m-0 font-weight-bold text-primary">Search Filters</h6>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label font-weight-bold">Branch Code</label>
                    <input type="number" name="branchCode" class="form-control" value="@ViewData["BranchCode"]" placeholder="e.g. 101">
                </div>
                <div class="col-md-2">
                    <label class="form-label font-weight-bold">User ID</label>
                    <input type="number" name="userId" class="form-control" value="@ViewData["UserId"]" placeholder="User ID">
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-bold">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@ViewData["FromDate"]">
                </div>
                <div class="col-md-3">
                    <label class="form-label font-weight-bold">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@ViewData["ToDate"]">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Search Result
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover border" id="auditTable">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th style="width: 15%">Timestamp (UTC)</th>
                            <th style="width: 10%">Branch Code</th>
                            <th style="width: 15%">User Name</th>
                            <th style="width: 10%">Action</th>
                            <th style="width: 15%">Target Table</th>
                            <th style="width: 25%">Changes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="small font-weight-bold">@item.CreatedAt.ToString("dd-MMM-yyyy HH:mm:ss")</td>
                                    <td><span class="badge bg-info text-dark">@item.BranchCode</span></td>
                                    <td>@item.CreatedBy</td>
                                    <td>
                                        @{
                                            var badgeClass = item.Action.ToUpper() switch
                                            {
                                                "CREATE" => "bg-success",
                                                "UPDATE" => "bg-warning text-dark",
                                                "DELETE" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@item.Action</span>
                                    </td>
                                    <td class="text-uppercase small">@item.TableName</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary py-0"
                                                onclick="showAuditDetails('@Html.Raw(JavaScriptEncoder.Default.Encode(item.OldValue ?? "{}"))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.NewValue ?? "{}"))')">
                                            <i class="fas fa-eye"></i> View Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-danger py-4">No audit logs found for the selected criteria.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageNumber - 1, branchCode = ViewData["BranchCode"], userId = ViewData["UserId"], fromDate = ViewData["FromDate"], toDate = ViewData["ToDate"] })">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { pageNumber = i, branchCode = ViewData["BranchCode"], userId = ViewData["UserId"], fromDate = ViewData["FromDate"], toDate = ViewData["ToDate"] })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { pageNumber = Model.PageNumber + 1, branchCode = ViewData["BranchCode"], userId = ViewData["UserId"], fromDate = ViewData["FromDate"], toDate = ViewData["ToDate"] })">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="auditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title"><i class="fas fa-search-plus"></i> Data Comparison Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-danger border-bottom pb-2 font-weight-bold">PREVIOUS STATE (OLD)</h6>
                        <pre id="oldJson" class="p-3 bg-white border rounded" style="font-size: 12px; max-height: 400px; overflow-y: auto;"></pre>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-success border-bottom pb-2 font-weight-bold">CURRENT STATE (NEW)</h6>
                        <pre id="newJson" class="p-3 bg-white border rounded" style="font-size: 12px; max-height: 400px; overflow-y: auto;"></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAuditDetails(oldData, newData) {
            try {
                // JSON সুন্দর করে দেখানোর জন্য ফরম্যাটিং করা হচ্ছে
                const oldObj = JSON.parse(oldData);
                const newObj = JSON.parse(newData);

                document.getElementById('oldJson').textContent = JSON.stringify(oldObj, null, 4);
                document.getElementById('newJson').textContent = JSON.stringify(newObj, null, 4);
            } catch (e) {
                // যদি JSON না হয়ে প্লেন টেক্সট হয়
                document.getElementById('oldJson').textContent = oldData;
                document.getElementById('newJson').textContent = newData;
            }

            var myModal = new bootstrap.Modal(document.getElementById('auditModal'));
            myModal.show();
        }
    </script>
}