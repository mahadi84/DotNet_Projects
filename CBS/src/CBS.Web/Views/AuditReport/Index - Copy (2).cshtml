@using CBS.Domain.Common
@using CBS.Application.DTO
@using System.Text.Encodings.Web
@model PagedResult<IEnumerable<AuditReportViewDTO>>

@{
    ViewData["Title"] = "Audit Trail Report";
}

<style>
    /* Simple Overlay CSS */
    .custom-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }

    .custom-modal-content {
        background: #fff;
        padding: 20px;
        border-radius: 8px;
        width: 80%;
        max-height: 90vh;
        overflow-y: auto;
    }

    pre {
        background: #f8f9fa;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="fas fa-file-invoice"></i> Audit Trail Report</h3>
        <a href="@Url.Action("Index")" class="btn btn-sm btn-outline-secondary">Refresh</a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-2">
                <div class="col-md-2">
                    <input type="number" name="branchCode" class="form-control" value="@ViewData["BranchCode"]" placeholder="Branch Code">
                </div>
                <div class="col-md-2">
                    <input type="number" name="userId" class="form-control" value="@ViewData["UserId"]" placeholder="User ID">
                </div>
                <div class="col-md-3">
                    <input type="date" name="fromDate" class="form-control" value="@ViewData["FromDate"]">
                </div>
                <div class="col-md-3">
                    <input type="date" name="toDate" class="form-control" value="@ViewData["ToDate"]">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive bg-white shadow-sm p-3">
        <table class="table table-sm table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Timestamp</th>
                    <th>Branch</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Table</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.BranchCode</td>
                            <td>@item.CreatedBy</td>
                            <td><span class="badge @(item.Action == "DELETE" ? "bg-danger" : "bg-primary")">@item.Action</span></td>
                            <td class="text-muted">@item.TableName</td>
                            <td>
                                <button class="btn btn-sm btn-link" onclick="showDetails('@Html.Raw(JavaScriptEncoder.Default.Encode(item.OldValue ?? "{}"))', '@Html.Raw(JavaScriptEncoder.Default.Encode(item.NewValue ?? "{}"))')">
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center">No records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="detailOverlay" class="custom-overlay">
    <div class="custom-modal-content shadow-lg">
        <div class="d-flex justify-content-between border-bottom mb-3 pb-2">
            <h5 class="m-0">Audit Details</h5>
            <button class="btn-close" onclick="closeDetails()"></button>
        </div>
        <div class="row">
            <div class="col-md-6">
                <small class="text-danger fw-bold">OLD STATE</small>
                <pre id="oldJson"></pre>
            </div>
            <div class="col-md-6">
                <small class="text-success fw-bold">NEW STATE</small>
                <pre id="newJson"></pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showDetails(oldData, newData) {
            try {
                document.getElementById('oldJson').textContent = JSON.stringify(JSON.parse(oldData), null, 4);
                document.getElementById('newJson').textContent = JSON.stringify(JSON.parse(newData), null, 4);
            } catch (e) {
                document.getElementById('oldJson').textContent = oldData;
                document.getElementById('newJson').textContent = newData;
            }
            document.getElementById('detailOverlay').style.display = 'flex';
        }

        function closeDetails() {
            document.getElementById('detailOverlay').style.display = 'none';
        }

        // Close if user clicks outside the white box
        window.onclick = function(event) {
            let overlay = document.getElementById('detailOverlay');
            if (event.target == overlay) closeDetails();
        }
    </script>
}